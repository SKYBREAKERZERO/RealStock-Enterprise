# Development uses the Vite proxy.
# Browser requests /api and Vite proxies them to FastAPI :8000.

VITE_APP_NAME=RealStock Enterprise

# Local/demo identity.
# Production authentication will replace this with a verified identity.
VITE_DEMO_USER_ID=user-001

# Frontend runtime / paper-trading mode.
# local: local Docker + LocalStack
# aws: deployed AWS runtime
VITE_RUNTIME_ENV=local

# simulated: show the local Redis quote simulator
# alpaca: hide simulator and use backend real bid/ask provider
VITE_TRADING_QUOTE_SOURCE=simulated

# Optional API origin. Leave empty for same-origin nginx /api proxy.
# VITE_API_BASE_URL=
