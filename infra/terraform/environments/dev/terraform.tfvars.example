# ============================================================
# RealStock Dev Environment
#
# Copy this file to a local *.tfvars file only when performing
# a real AWS deployment.
#
# Never commit real secret values.
# ============================================================


# ============================================================
# AWS / Network
# ============================================================

aws_region = "ap-northeast-1"

vpc_cidr = "10.20.0.0/16"

# Optional explicit two-AZ override.
#
# Leave empty to automatically select two available AZs.
availability_zones = []

# Dev cost-optimized topology.
#
# Production should normally use:
#
# nat_gateway_mode = "per_az"
nat_gateway_mode = "single"


# ============================================================
# API Container Runtime
# ============================================================

api_desired_count = 2

api_cpu    = 512
api_memory = 1024

enable_http_redirect = false

enable_alb_deletion_protection = false

enable_ecs_exec = false


# ============================================================
# Required Deployment Values
# ============================================================

# Use an immutable Git SHA or release tag.
#
# Never use "latest".
#
# api_image_tag = "<immutable-image-tag>"


# Existing ACM certificate in the same AWS region as the ALB.
#
# api_certificate_arn = "<acm-certificate-arn>"


# ============================================================
# Application Configuration
# ============================================================

# Additional non-secret environment variables.
#
# REDIS_URL must NOT be supplied here.
#
# Terraform generates REDIS_URL automatically from the private
# ElastiCache primary endpoint using the rediss:// TLS scheme.
api_environment_variables = {}


# DATABASE_URL remains an application secret.
#
# Store its actual value in AWS Secrets Manager or SSM Parameter
# Store and provide only the secret ARN here.
#
# REDIS_URL must NOT be placed in this map.
#
# Example:
#
# api_secrets = {
#   DATABASE_URL = "<secrets-manager-or-ssm-arn>"
# }


# Optional customer-managed KMS keys required to decrypt the
# application secrets above.
api_kms_key_arns = []


# Optional least-privilege business-resource policy for the ECS
# task role.
#
# Do not add broad permissions here. Resource permissions for
# DynamoDB, Kinesis, EventBridge, SQS, SNS and S3 should be
# introduced only when their real resource ARNs exist.
#
# api_task_policy_json = null


# ============================================================
# Aurora PostgreSQL
# ============================================================

database_name = "realstock"

database_master_username = "realstock_admin"


# Optional explicit Aurora PostgreSQL engine version.
#
# When omitted/null, AWS/provider defaults are used.
database_engine_version = null


database_instance_class = "db.t4g.medium"

# HA baseline:
#
# Writer + at least one additional Aurora instance.
database_instance_count = 2


database_backup_retention_days = 7


# Dev defaults.
#
# Production should normally enable deletion protection and
# retain a final snapshot.
database_deletion_protection = false

database_skip_final_snapshot = true


# Optional customer-managed KMS key for Aurora storage.
#
# When null, AWS-managed encryption is used.
database_kms_key_arn = null


# ============================================================
# ElastiCache Redis
# ============================================================

redis_engine_version = "7.1"

redis_node_type = "cache.t4g.micro"


# HA baseline:
#
# Primary + replica.
redis_num_cache_clusters = 2


redis_snapshot_retention_days = 7


# Optional customer-managed KMS key for Redis encryption
# at rest.
#
# When null, AWS-managed encryption is used.
redis_kms_key_arn = null


# Prefer maintenance-window changes by default.
redis_apply_immediately = false